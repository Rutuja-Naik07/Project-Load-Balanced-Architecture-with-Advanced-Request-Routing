{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowReadWebsiteFiles",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "YOUR-BUCKET-ARN/*"
    },
    {
      "Sid": "AllowListBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "YOUR-BUCKET-ARN"
    }
  ]
}
